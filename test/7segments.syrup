not(<Bit>) -> <Bit>
!X = nand(X,X)

displayBit(<Bit>) -> <7Segments>
displayBit(X) = [!X, !X, !0, 0, !X, !0, !X]

type displayBit
print displayBit

experiment displayBit


displayBits2(<Bit>, <Bit>) -> [<7Segments>, <7Segments>]
displayBits2(X, Y) = [displayBit(X), displayBit(Y)]

type displayBits2
print displayBits2

experiment displayBits2

displayBits4(<Bit>, <Bit>, <Bit>, <Bit>) -> <7Segments>, <7Segments>, <7Segments>, <7Segments>
displayBits4(X, Y, Z, A) = displayBit(X), displayBit(Y), displayBit(Z), displayBit(A)

type displayBits4
print displayBits4

experiment displayBits4
